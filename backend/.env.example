NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/couple_memories
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
# Set to true when served over HTTPS (always true in real production)
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SMTP (without it, verification / reset links are printed to the server console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Couple Memories <no-reply@example.com>"
